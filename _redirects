# Cloudflare Pages URL redirect rules
# Kaynak: https://developers.cloudflare.com/pages/configuration/redirects/
#
# ÖNEMLİ: Cloudflare Pages TEMİZ URL'LERİ OTOMATİK yönetir.
# /sss.html → otomatik /sss URL'inde servis edilir.
# Buraya sadece ALIAS'lar, LEGACY ve DİL yönlendirmeleri yazılır.

# ============================================================
# ÇOK DİLLİ URL'LER (rewrite: URL değişmez, içerik TR'den gelir)
# Google Translate JS ile otomatik çeviri yapılır (translator.js)
# ============================================================
# İngilizce
/en                         /                             200
/en/                        /                             200
/en/*                       /:splat                       200
# Fransızca
/fr                         /                             200
/fr/                        /                             200
/fr/*                       /:splat                       200
# Almanca
/de                         /                             200
/de/                        /                             200
/de/*                       /:splat                       200
# Rusça
/ru                         /                             200
/ru/                        /                             200
/ru/*                       /:splat                       200
# Arapça (YENİ)
/ar                         /                             200
/ar/                        /                             200
/ar/*                       /:splat                       200

# ---- Aliaslar (FAQ sayfası için ek URL'ler) ----
/faq                        /sss                          301
/faq.html                   /sss                          301
/sikca-sorulan-sorular      /sss                          301

# ---- Türkçe/İngilizce alias'lar ----
/hakkimda                   /hakkimizda                   301
/contact                    /iletisim                     301
/account                    /hesabim                      301

# ---- Kısa/genel kategori URL'leri → gerçek sayfaya ----
/yalova-satilik             /yalova-satilik-daire         301
/yalova-kiralik             /yalova-kiralik-daire         301
/luks                       /yalova-kiralik-villa         301
