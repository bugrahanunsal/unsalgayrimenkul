# Cloudflare Pages custom headers
# Kaynak: https://developers.cloudflare.com/pages/configuration/headers/

# script.js: her zaman fresh çek (cache-busting'in çalışabilmesi için)
/script.js
  Cache-Control: no-cache, must-revalidate

# HTML sayfalar: kısa cache (deploy hızlı görünsün)
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Diğer JS dosyaları: cache-buster query parametresi zaten var
/*.js
  Cache-Control: public, max-age=3600

# Statik varlıklar (resimler, fontlar): uzun cache
/*.jpg
  Cache-Control: public, max-age=604800, immutable
/*.png
  Cache-Control: public, max-age=604800, immutable
/*.webp
  Cache-Control: public, max-age=604800, immutable
# /img/: fotoğraflar (.webp önbelleği yukarıdaki /*.webp kuralından gelir)
/img/*
  X-Content-Type-Options: nosniff
/*.svg
  Cache-Control: public, max-age=604800, immutable

# Yönetim paneli (/admin/*): Pages Functions bu yolda çalışmaz (_routes.json), başlıklar buradan verilir.
# Başka sitelerin paneli görünmez çerçeve içine alıp tıklatmasını engeller (clickjacking), dosya türü
# tahminini kapatır, panel adreslerini dış sitelere sızdırmaz, arama motorlarına kapalı tutar.
/admin/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Admin → Analitik: Google girişi (Google Identity Services, salt okunur Analytics izni) ve Google Analytics API'leri
# YALNIZCA bu sayfada. Satır içi betik yok → sıkı içerik güvenliği (CSP). Google'ın giriş penceresi için
# same-origin-allow-popups (pencere açanla konuşabilsin).
/admin/analytics*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2 https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://gosmkthmamloafgtvhpj.supabase.co wss://gosmkthmamloafgtvhpj.supabase.co https://accounts.google.com/gsi/ https://oauth2.googleapis.com https://analyticsdata.googleapis.com https://analyticsadmin.googleapis.com https://api.ipify.org; frame-src 'self' https://accounts.google.com/gsi/; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  Cross-Origin-Opener-Policy: same-origin-allow-popups
