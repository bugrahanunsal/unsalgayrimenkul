# Cloudflare Pages custom headers
# Kaynak: https://developers.cloudflare.com/pages/configuration/headers/

# script.js: her zaman fresh çek (cache-busting'in çalışabilmesi için)
/script.js
  Cache-Control: no-cache, must-revalidate

# HTML sayfalar: kısa cache (deploy hızlı görünsün)
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Diğer JS dosyaları: cache-buster query parametresi zaten var
/*.js
  Cache-Control: public, max-age=3600

# Statik varlıklar (resimler, fontlar): uzun cache
/*.jpg
  Cache-Control: public, max-age=604800, immutable
/*.png
  Cache-Control: public, max-age=604800, immutable
/*.svg
  Cache-Control: public, max-age=604800, immutable

# Yönetim paneli (/admin/*): Pages Functions bu yolda çalışmaz (_routes.json), başlıklar buradan verilir.
# Başka sitelerin paneli görünmez çerçeve içine alıp tıklatmasını engeller (clickjacking), dosya türü
# tahminini kapatır, panel adreslerini dış sitelere sızdırmaz, arama motorlarına kapalı tutar.
/admin/*
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
